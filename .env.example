# Copy to .env.local and fill in your OWN keys. .env.local is gitignored.
# Everything here is read SERVER-SIDE only (in /api). NEVER prefix with VITE_
# (that would ship the value to the browser).

# --- AI features (optional): screenshot import + cut-back tips ---
# The backend builds a rotating pool from whichever of these are set (in this order),
# failing over to the next when one is rate-limited. The app runs fine with none set.
# Groq — free, no card, free vision (llama-4-scout). https://console.groq.com
GROQ_API_KEY=
# Google Gemini — free vision (flash-lite). Make the key in AI Studio, not Cloud Console.
GEMINI_API_KEY=
# OpenRouter — one key, many free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Accounts + cloud sync (required for user accounts) ---
# Neon pooled connection string. Provision free at neon.tech (or Vercel Marketplace
# → Neon, which injects this automatically). Apply schema.sql once against it.
DATABASE_URL=

# Secret that signs session cookies (HS256). Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be set in production. Rotating it signs everyone out.
SESSION_SECRET=

# --- Bank feed / Open Banking (NOT BUILT — see docs/open-banking-spec.md) ---
# Everything below is a placeholder for a feature that is spec'd but not
# implemented. api/bank/*.js return 501 regardless of what's set here. Do NOT
# put a real value on any of these lines without reading the spec first —
# which provider to use is Sam's decision, and he has to sign up for it
# himself (an AI agent cannot create a Monzo Developer / TrueLayer / GoCardless
# account on his behalf).
#
# Uncomment ONE provider's pair once Sam has picked one and signed up:
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
# ENABLEBANKING_APPLICATION_ID=
# ENABLEBANKING_PRIVATE_KEY=
#
# Encrypts bank_connections.access_token_enc / refresh_token_enc at rest
# (AES-256-GCM, see src/lib/bank-crypto.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BANK_TOKEN_ENC_KEY=
